# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (unanchored — every workspace has its own)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare workers: wrangler local state + dev secrets
.wrangler/
.dev.vars
!.dev.vars.example

# neon cli local context (org/project ids — never commit)
.neon

# claude code local project context (settings.local.json etc.)
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts
