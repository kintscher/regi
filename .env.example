# Copy to .env.local and fill in. .env.local is never committed.

# Canonical base URL. regi.ch is not registered yet; regi.app is the
# placeholder until the domain is secured. Drives canonical/OG URLs.
SITE_URL=https://regi.app

# Anthropic API key — reserved for a later "Frag regi" feature. Not used
# by the §11.1–3 bootstrap; placeholder only.
ANTHROPIC_API_KEY=

# Neon Postgres connection strings are added at the Neon setup step (§11.2):
#   DATABASE_URL           pooled, for the RSC/serverless HTTP driver
#   DATABASE_URL_UNPOOLED  direct, for Drizzle Kit migrations
