# Copy to .env.local and fill in. .env.local is never committed; this file is.
# Both apps/web and apps/ingest (via wrangler dev) read from the repo-root
# .env.local. apps/web/.env.local is a symlink to this file in dev.

# ── Neon Postgres: pooled / unpooled split (see ADR 0005) ───────────────────
#
# DATABASE_URL          Pooled connection (host contains `-pooler`, PgBouncer).
#                       Used by the APP at runtime: React Server Components,
#                       serverless/edge — via the Neon HTTP driver.
#
# DATABASE_URL_UNPOOLED Direct connection (no `-pooler`). Used ONLY by Drizzle
#                       Kit migrations, which need the raw Postgres wire
#                       protocol that the pooler does not expose.
#
# Each Neon branch (dev, production) has its own pair. Local .env.local holds
# the dev branch pair. The production pair lives in Vercel Project Settings,
# never in any committed file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# Canonical base URL. regi.ch is the target domain; regi.app is the fallback
# placeholder until the domain is secured. Drives canonical / OG URLs.
SITE_URL=http://localhost:3000

# Shared secret for the ingest → /api/revalidate webhook (x-ingest-secret
# header). Generate locally with:  openssl rand -base64 32
INGEST_REVALIDATE_SECRET=

# Outbound fetch User-Agent for source fetchers. Canonical value is defined in
# CLAUDE.md §7 and consumed by the regi-ingest worker.
REGI_USER_AGENT=regi/1.0 (+https://regi.ch; contact: youremail@example.com)

# Eventfrog public API key. Self-service: log in at eventfrog.ch, open
# account settings → API keys, generate a Public API key. Required for the
# eventfrog source in apps/ingest; without it the source short-circuits.
EVENTFROG_API_KEY=

# Anthropic API key — reserved for a later "Frag regi" feature. Not used by
# the current ingest sources; placeholder only.
ANTHROPIC_API_KEY=
