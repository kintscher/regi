{
  "name": "regi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "web": "pnpm --filter @regi/web",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check",
    "format": "biome check --write",
    "db:generate": "pnpm --filter @regi/db generate",
    "db:migrate": "pnpm --filter @regi/db migrate",
    "db:studio": "pnpm --filter @regi/db studio",
    "db:seed": "pnpm --filter @regi/db seed",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "typescript": "^5"
  }
}
